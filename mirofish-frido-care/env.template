# MiroFish config for a free setup (NVIDIA build + Zep Cloud Free).
# Copy to MiroFish/.env and paste your keys. Never commit the real .env.

# LLM: NVIDIA build.nvidia.com (free, ~40 requests/min)
LLM_API_KEY=nvapi-PASTE_YOUR_KEY_HERE
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL_NAME=meta/llama-3.3-70b-instruct

# Memory graph: Zep Cloud (free plan, 10k credits/month)
ZEP_API_KEY=PASTE_YOUR_ZEP_KEY_HERE

# Keep pilots small so free limits hold
OASIS_DEFAULT_MAX_ROUNDS=10
